STATSKILL_PORT=8000
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
# Grounded study quizzes, Hindi and depths 4–6 use 8B. Simple general tasks use 3B.
STATSKILL_QUIZ_MODEL=llama3.2:3b
STATSKILL_QUIZ_CONTEXT_LENGTH=4096
STATSKILL_QUIZ_GPU_LAYERS=-1
STATSKILL_EVALUATION_MODEL=llama3.1:8b
STATSKILL_RECOMMENDATION_MODEL=llama3.1:8b
# -1 lets Ollama choose GPU offload. This RTX 4050 6 GB installation uses 24 layers.
# Use 0 only for deliberate CPU-only troubleshooting.
STATSKILL_GPU_LAYERS=-1
STATSKILL_QUIZ_BATCH_SIZE=2
STATSKILL_MODEL_TIMEOUT=300
# Larger-model context used for evaluation and recommendations.
STATSKILL_CONTEXT_LENGTH=8192
STATSKILL_EMBED_MODEL=all-MiniLM-L6-v2
WHISPER_MODEL=base
# Set only if converters are installed outside the usual Windows locations:
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# LIBREOFFICE_CMD=C:/Program Files/LibreOffice/program/soffice.exe

# Email/SMS gateways are optional. Unconfigured verification is clearly marked local demo.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# FAST2SMS_API_KEY=
